<%- include('../header.ejs') %>
    <div class="list-filter p-3 bg-white rounded-2 bs-border d-flex align-items-center justify-content-between">
        <div class="filter-area d-flex align-items-center gap-2 flex-wrap" id="coupon-filter-section">
            <!-- Dynamic filters can be placed here if needed -->
        </div>
        <div class="d-flex align-items-center flex-wrap justify-content-end gap-2">
            <div class="pagination-show d-flex align-items-center" id="pagination-div-coupon-list-table-data">
                Show
                <select id="recordPerPage-coupon-list-table-data" class="form-select form-select-sm w-auto" onchange="changeRecordPerPage('/coupon-list', 'coupon-list-table-data')">
                    <option selected="">10</option>
                    <option value="20">20</option>
                    <option value="40">40</option>
                </select>
            </div>
            <div class="page navigation example">
                <ul class="pagination justify-content-end mb-0 gap-0"></ul>
            </div>
        </div>
    </div>
    <div class="admin-table coupon-list-table mt-30" id="coupon-list-table-data"></div>

    <div class="container">
        <div id="add_new_coupon_btn" class="add-list" data-bs-toggle="modal" data-bs-target="#couponModal">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g clip-path="url(#clip0_460_20805)">
                    <path d="M20 8.33337V31.6667" stroke="#ffffff" stroke-width="4" stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    <path d="M8.32812 20H31.6615" stroke="#ffffff" stroke-width="4" stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </g>
                <defs>
                    <clipPath id="clip0_460_20805">
                        <rect width="40" height="40" fill="white"></rect>
                    </clipPath>
                </defs>
            </svg>
        </div>
    </div>

    <!-- Add/Edit Coupon Modal -->
    <div class="modal custom-popup fade" id="couponModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header justify-content-center mt-3">
                    <h5 class="modal-title" id="couponModalLabel">Add Coupon</h5>
                </div>
                <div class="modal-body px-4 pb-4">
                    <input type="hidden" id="coupon_id" value="">
                    <div class="row g-3">
                        <div class="col-lg-12">
                            <label class="form-label text-dark">Coupon Code <span class="text-danger">*</span></label>
                            <input class="form-control text-uppercase" type="text" id="coupon_code" placeholder="Enter coupon code (e.g. SUMMER50)">
                        </div>
                        <div class="col-lg-12">
                            <label class="form-label text-dark">Description</label>
                            <textarea class="form-control" id="coupon_description" rows="2" placeholder="Enter description"></textarea>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label text-dark">Discount Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="coupon_discount_type">
                                <option value="percentage" selected>Percentage (%)</option>
                                <option value="fixed">Fixed Amount</option>
                            </select>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label text-dark">Discount Value <span class="text-danger">*</span></label>
                            <input class="form-control" type="number" id="coupon_discount_value" step="any" min="0" placeholder="Enter value">
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label text-dark">Min Order Amount</label>
                            <input class="form-control" type="number" id="coupon_min_order_amount" step="any" min="0" value="0">
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label text-dark">Max Discount Amount</label>
                            <input class="form-control" type="number" id="coupon_max_discount_amount" step="any" min="0" value="0">
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label text-dark">Usage Limit</label>
                            <input class="form-control" type="number" id="coupon_usage_limit" min="0" value="0">
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label text-dark">Expiry Date <span class="text-danger">*</span></label>
                            <input class="form-control" type="date" id="coupon_expiry_date">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 d-flex justify-content-end">
                    <button type="button" class="btn btn-primary btn-transparent" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="save_coupon">Save Coupon</button>
                    <button type="button" class="btn btn-primary d-none" id="update_coupon">Update Coupon</button>
                </div>
            </div>
        </div>
    </div>
<%- include('../footer.ejs') %>
