<div class="table-responsive">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th class="text-center">Name</th>
                <th class="text-center">Native Name</th>
                <th class="text-center">Language Code</th>
                <th class="text-center">Status</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            <% if (body?.languageList && body.languageList.length > 0) { %>
                <% body.languageList.forEach(function(lang, index) { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td class="text-center">
                            <strong><%= lang.name || "-" %></strong>
                        </td>
                        <td class="text-center"><%= lang.nativeName || "-" %></td>
                        <td class="text-center">
                            <span class="badge bg-secondary"><%= lang.languageCode || "-" %></span>
                        </td>
                        <td>
                            <div class="action-btn d-flex flex-wrap gap-2 justify-content-center">
                                <select class="form-select form-select-sm language-status-select text-border text-space" data-language-id="<%= lang._id %>" style="width: auto;">
                                    <option value="true" <%= lang.isActive ? "selected" : "" %>>Active</option>
                                    <option value="false" <%= !lang.isActive ? "selected" : "" %>>Inactive</option>
                                </select>
                            </div>
                        </td>
                        <td>
                            <div class="action-btn d-flex flex-wrap gap-2 justify-content-center">
                                <a href="javascript:void(0);" class="edit-language text-primary me-2" data-language-id="<%= lang._id %>" title="Edit">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </a>
                                <a href="javascript:void(0);" class="delete-language text-danger" data-language-id="<%= lang._id %>" title="Delete">
                                    <i class="fa-regular fa-trash-can"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="text-center">No Languages found</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>
