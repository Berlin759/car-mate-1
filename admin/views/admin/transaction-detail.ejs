<%- include('../header.ejs') %>

<%
    function capitalizeFirstLetter(str) {
        if (!str) return "";
        return str.charAt(0).toUpperCase() + str.slice(1);
    };

    function formatDateFull(date) {
        if (!date) return "-";
        let d = new Date(date);
        let day = ("0" + d.getDate()).slice(-2);
        let month = ("0" + (d.getMonth() + 1)).slice(-2);
        let year = d.getFullYear();
        let hours = ("0" + d.getHours()).slice(-2);
        let minutes = ("0" + d.getMinutes()).slice(-2);
        return `${year}-${month}-${day} ${hours}:${minutes}`;
    };

    function getTransactionStatusBadge(status) {
        const map = {
            1: { text: "Pending", class: "text-warning" },
            2: { text: "Paid", class: "text-success" },
            3: { text: "Failed", class: "text-danger" },
            4: { text: "Refunded", class: "text-gray" },
        };
        return map[status] || { text: "Unknown", class: "text-gray" };
    };

    function getBookingStatusBadge(status) {
        const map = {
            1: { text: "Pending", class: "alert-pending" },
            2: { text: "Accepted", class: "alert-accept" },
            3: { text: "Rejected", class: "alert-end" },
            4: { text: "En Route", class: "alert-accept" },
            5: { text: "Arrived", class: "alert-accept" },
            6: { text: "In Progress", class: "alert-accept" },
            7: { text: "Completed", class: "alert-success" },
            8: { text: "Paid", class: "alert-success" },
            9: { text: "Closed", class: "alert-success" },
            10: { text: "Failed", class: "alert-end" },
            11: { text: "Cancelled", class: "alert-end" },
        };
        return map[status] || { text: "Unknown", class: "alert-gray" };
    };

    function getPayoutStatusBadge(status) {
        const map = {
            1: { text: "Pending", class: "alert-pending", textClass: "text-warning" },
            2: { text: "Completed", class: "alert-success", textClass: "text-success" },
            3: { text: "Failed", class: "alert-end", textClass: "text-danger" },
            4: { text: "Processing", class: "alert-gray", textClass: "text-gray" },
        };
        return map[status] || { text: "Unknown", class: "alert-gray", textClass: "text-gray" };
    };

    function getCarFuelTypeText(type) {
        const map = {
            1: { text: "Petrol", class: "text-success" },
            2: { text: "Diesel", class: "text-success" },
            3: { text: "EV", class: "text-success" },
            4: { text: "CNG", class: "text-success" },
        };

        return map[type] || { text: "Unknown", class: "text-gray" };
    };

    let txn = body?.transaction || {};

    let txnStatus = getTransactionStatusBadge(txn.status);
    let bookStatus = txn.bookingDetails ? getBookingStatusBadge(txn.bookingDetails.status) : null;
    let payoutStatus = txn.earningDetails ? getPayoutStatusBadge(txn.earningDetails.status) : null;
    let carFuelInfo = txn.carDetails ? getCarFuelTypeText(parseInt(txn.carDetails?.fuelType)) : null;
%>

<div class="d-flex align-items-center justify-content-between mb-30">
    <a href="/transactions" class="btn btn-outline-secondary d-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="bg-white rounded-2 bs-border p-4 mb-30">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="sc-img d-flex align-items-center justify-content-center rounded-circle" style="background: #e8f5e9; width: 56px; height: 56px;">
                    <i class="fa-solid fa-money-bill-transfer text-success fs-5"></i>
                </div>
                <div>
                    <h5 class="mb-1"><%= txn?.bookingDetails?.invoiceNo || "-" %></h5>
                    <span class="text-gray">Transaction ID: <%= txn._id || "-" %></span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="bg-white rounded-2 bs-border p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="sc-img d-flex align-items-center justify-content-center rounded-circle" style="background: #e3f2fd; width: 48px; height: 48px;">
                    <i class="fa-solid fa-hashtag text-primary"></i>
                </div>
                <div>
                    <span class="fs-14 text-gray d-block mb-1">TRX ID</span>
                    <span class="fw-md"><%= txn.trxId || "-" %></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-white rounded-2 bs-border p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="sc-img d-flex align-items-center justify-content-center rounded-circle" style="background: #e8f5e9; width: 48px; height: 48px;">
                    <i class="fa-solid fa-user text-success"></i>
                </div>
                <div>
                    <span class="fs-14 text-gray d-block mb-1">Car Owner</span>
                    <span class="fw-md"><%= txn.ownerDetails?.fullName || "-" %></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-white rounded-2 bs-border p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="sc-img d-flex align-items-center justify-content-center rounded-circle" style="background: #fff3e0; width: 48px; height: 48px;">
                    <i class="fa-solid fa-wrench text-warning"></i>
                </div>
                <div>
                    <span class="fs-14 text-gray d-block mb-1">Mechanic</span>
                    <span class="fw-md"><%= txn.mechanicDetails?.fullName || "-" %></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-white rounded-2 bs-border p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="sc-img d-flex align-items-center justify-content-center rounded-circle" style="background: #f3e5f5; width: 48px; height: 48px;">
                    <i class="fa-solid fa-cog text-purple"></i>
                </div>
                <div>
                    <span class="fs-14 text-gray d-block mb-1">Service</span>
                    <span class="fw-md"><%= txn.serviceDetails?.fullName || "-" %></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-white rounded-2 bs-border p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="sc-img d-flex align-items-center justify-content-center rounded-circle" style="background: #e3f2fd; width: 48px; height: 48px;">
                    <i class="fa-solid fa-car text-primary"></i>
                </div>
                <div>
                    <span class="fs-14 text-gray d-block mb-1">Vehicle</span>
                    <span class="fw-md">
                        <%= txn?.carDetails?.vehicleNumber || "-" %> <span class="fw-bold fs-16 <%= carFuelInfo.class %>">(<%= carFuelInfo.text %>)</span>
                    </span>
                    <span class="text-gray fs-12 d-block">
                        <%= txn?.carDetails?.model || "" %> <%= txn?.carDetails?.vehicleManufacturerName ? "- " + txn?.carDetails?.vehicleManufacturerName : "" %>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-white rounded-2 bs-border p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="sc-img d-flex align-items-center justify-content-center rounded-circle" style="background: #e8f5e9; width: 48px; height: 48px;">
                    <i class="fa-solid fa-calendar text-success"></i>
                </div>
                <div>
                    <span class="fs-14 text-gray d-block mb-1">Date</span>
                    <span class="fw-md"><%= formatDateFull(txn.createdAt) || "-" %></span>
                </div>
            </div>
        </div>
    </div>
</div>

<% if (txn.bookingDetails) { %>
    <div class="bg-white rounded-2 bs-border p-4 mt-30">
        <h6 class="mb-3">Booking Reference</h6>
        <hr>
        <div class="row">
            <div class="col-md-6 mb-3">
                <span class="text-gray fs-14 d-block mb-1">Booking ID</span>
                <span class="fw-md"><%= txn.bookingId || "-" %></span>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-gray fs-14 d-block mb-1">Booking Date</span>
                <span class="fw-md"><%= formatDateFull(txn.bookingDetails.date) || "-" %></span>
            </div>
            <div class="col-md-6">
                <span class="text-gray fs-14 d-block mb-1">Booking Slot</span>
                <span class="fw-md"><%= txn.bookingDetails.slot || "-" %></span>
            </div>
            <div class="col-md-6">
                <span class="text-gray fs-14 d-block mb-1">Booking Status</span>
                <% if (bookStatus) { %>
                    <span class="bet-status <%= bookStatus.class %>"><%= bookStatus.text %></span>
                <% } else { %>
                    <span class="text-gray">-</span>
                <% } %>
            </div>
            <% if (txn?.bookingDetails?.canceledByDetails) { %>
                <div class="col-md-6 mt-3">
                    <span class="text-gray fs-14 d-block mb-1">Canceled By</span>
                    <span class="fw-md">
                        <%= txn?.bookingDetails?.canceledByDetails?.fullName || "-" %> (<%= capitalizeFirstLetter(txn?.bookingDetails?.canceledByRole) %>)
                    </span>
                </div>
            <% } %>
        </div>
    </div>
<% } %>

<div class="bg-white rounded-2 bs-border p-4 mt-30">
    <h6 class="mb-3">Payment Details</h6>

    <!-- Service Details -->
    <div class="price-breakdown mt-3 pt-3 border-top">
        <div class="d-flex justify-content-between align-items-center py-2">
            <span class="text-gray fs-14">
                <%= txn?.serviceDetails?.fullName || "Service" %>
            </span>
            <span class="fw-md">
                ₹ <%= Number(txn?.bookingDetails?.totalServiceFee || 0).toFixed(2) %>
            </span>
        </div>
        <div class="d-flex justify-content-between align-items-center py-2">
            <span class="text-gray fs-14">Consultant Fee</span>
            <span class="fw-md">
                ₹ <%= Number(txn?.bookingDetails?.consultantFee || 0).toFixed(2) %>
            </span>
        </div>
        <% if(txn?.bookingDetails?.discountAmount > 0) { %>
            <div class="d-flex justify-content-between align-items-center py-2">
                <span class="text-gray fs-14">Discount</span>
                <span class="fw-md text-danger">
                    - ₹ <%= Number(txn?.bookingDetails?.discountAmount || 0).toFixed(2) %>
                </span>
            </div>
        <% } %>
        <div class="d-flex justify-content-between align-items-center py-2">
            <span class="text-gray fs-14">
                Platform Fee (<%= Number(txn?.bookingDetails?.platformFee || 0) %><%=  parseInt(txn?.bookingDetails?.platformFeeType) === 1 ? "%" : "₹" %>)
            </span>
            <span class="fw-md">
                ₹ <%= Number(txn?.bookingDetails?.adminCharge || 0).toFixed(2) %>
            </span>
        </div>
    </div>

    <!-- Quotation -->
    <% if (txn?.bookingDetails?.quotation?.length) { %>
        <div class="mt-3 pt-3 border-top">
            <h6 class="fs-14 fw-semibold mb-2">Quotation</h6>
            <% txn?.bookingDetails?.quotation.forEach((item) => { %>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-gray fs-14">
                        <%= item?.serviceName || "Service" %>
                    </span>
                    <span class="fw-md">
                        ₹ <%= Number(item?.price || 0).toFixed(2) %>
                    </span>
                </div>
            <% }) %>
        </div>
    <% } %>

    <!-- Summary -->
    <div class="mt-3 pt-3 border-top">
        <div class="d-flex justify-content-between align-items-center py-2">
            <span class="text-gray fs-14">Sub Total</span>
            <span class="fw-md">
                ₹ <%= Number(txn?.bookingDetails?.subTotal || 0).toFixed(2) %>
            </span>
        </div>
        <div class="d-flex justify-content-between align-items-center py-2">
            <span class="text-gray fs-14">
                GST <%= Number(txn?.bookingDetails?.taxPercentage || 0) %>%
                <span class="fs-12">(Platform + Quotation)</span>
            </span>
            <span class="fw-md">
                ₹ <%= Number(txn?.bookingDetails?.taxAmount || 0).toFixed(2) %>
            </span>
        </div>
        <% if(txn?.bookingDetails?.cancellationFee > 0) { %>
            <div class="d-flex justify-content-between align-items-center py-2">
                <span class="text-gray fs-14">
                    Cancellation Fee (<%= Number(txn?.bookingDetails?.cancellationPercentage || 0) %>%)
                </span>
                <span class="fw-md text-danger">
                    - ₹ <%= Number(txn?.bookingDetails?.cancellationFee || 0).toFixed(2) %>
                </span>
            </div>
        <% } %>
    </div>
    <div class="mt-3 pt-3 border-top">
        <div class="d-flex justify-content-between align-items-center">
            <span class="fw-semibold fs-15">Total Amount</span>
            <span class="fw-bold fs-16 <%= txnStatus.class %>">
                <%= txnStatus.text %> ₹ <%= Number((txn?.bookingDetails?.totalAmount || 0) - (txn?.bookingDetails?.cancellationFee || 0)).toFixed(2) %>
            </span>
        </div>
    </div>
</div>

<% if (payoutStatus) { %>
    <div class="bg-white rounded-2 bs-border p-4 mt-30">
        <h6 class="mb-3">Payout Details</h6>

        <div class="price-breakdown mt-3 pt-3 border-top">
            <div class="d-flex justify-content-between align-items-center py-2">
                <span class="text-gray fs-14">Service Amount</span>
                <span class="fw-md">
                    ₹ <%= Number(txn?.bookingDetails?.totalAmount || 0).toFixed(2) %>
                </span>
            </div>
            <% if(parseFloat(txn?.bookingDetails?.cancellationFee) > 0) { %>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-gray fs-14">
                        Cancellation Fee (<%= Number(txn?.earningDetails?.adminCharge || 0) %>%)
                    </span>
                    <span class="fw-md text-danger">
                        - ₹ <%= Number(txn?.earningDetails?.totalAdminCharge || 0).toFixed(2) %>
                    </span>
                </div>
            <% } else { %>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-gray fs-14">
                        Admin Charge (<%= Number(txn?.earningDetails?.adminCharge || 0) %><%=  parseInt(txn?.earningDetails?.adminChargeType) === 1 ? "%" : "₹" %>)
                    </span>
                    <span class="fw-md text-danger">
                        - ₹ <%= Number(txn?.earningDetails?.totalAdminCharge || 0).toFixed(2) %>
                    </span>
                </div>
            <% } %>

            <div class="d-flex justify-content-between align-items-center py-2">
                <span class="text-gray fs-14">
                    GST Charge (<%= parseFloat(txn?.earningDetails?.taxPercentage || 0) %>%)
                </span>
                <span class="fw-md text-danger">
                    - ₹ <%= Number(txn?.earningDetails?.taxAmount || 0).toFixed(2) %>
                </span>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2">
                <span class="text-gray fs-14">Final Payout</span>
                <span class="fw-md <%= payoutStatus.textClass %>">
                    ₹ <%= Number(txn?.earningDetails?.finalPayoutAmount || 0).toFixed(2) %>
                </span>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2">
                <span class="text-gray fs-14">Payout Status</span>
                <span class="bet-status <%= payoutStatus.class %>">
                    <%= payoutStatus.text %>
                </span>
            </div>
        </div>
    </div>
<% } %>

<div class="bg-white rounded-2 bs-border p-4 mt-30">
    <h6 class="mb-3">Other Details</h6>
    <hr>
    <div class="row">
        <div class="col-md-6">
            <span class="text-gray fs-14 d-block mb-1">Created Date</span>
            <span class="fw-md"><%= formatDateFull(txn.createdAt) || "-" %></span>
        </div>
        <div class="col-md-6">
            <span class="text-gray fs-14 d-block mb-1">Last Updated</span>
            <span class="fw-md"><%= formatDateFull(txn.updatedAt) || "-" %></span>
        </div>
    </div>
</div>

<%- include('../footer.ejs') %>
