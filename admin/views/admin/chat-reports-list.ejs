<%
    function formatDate(date) {
        if(!date){ return "-"; }
        let d=new Date(date);
        let day=('0' + d.getDate()).slice(-2);
        let month=('0' + (d.getMonth() + 1)).slice(-2);
        let year=d.getFullYear();
        return `${year}-${month}-${day}`;
    };
%>

<div class="table-responsive">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Reported By</th>
                <th>Target User</th>
                <th>Reason</th>
                <th>Message Snippet</th>
                <th>Status</th>
                <th>Date</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            <% if (body?.reportList && body.reportList.length > 0) { body.reportList.forEach(function(report, index) { %>
                <% let start_index = (parseInt(body?.payload?.currentPage) - 1) * parseInt(body?.payload?.itemPerPage) + index + 1; %>
                <tr>
                    <td><%= start_index %></td>
                    <td>
                        <span class="badge bg-secondary me-1"><%= report.reportedByRole.toUpperCase() %></span>
                        <strong><%= report.reporterDetails?.fullName || "User" %></strong>
                    </td>
                    <td>
                        <span class="badge bg-secondary me-1"><%= report.reportedUserRole.toUpperCase() %></span>
                        <%= report.targetDetails?.fullName || "User" %>
                    </td>
                    <td><%= report.reason %></td>
                    <td>
                        <span class="text-truncate d-inline-block" style="max-width: 180px;">
                            <%= report.messageId?.message || (report.messageId?.type === 2 ? "[Document/Attachment]" : "[Location]") %>
                        </span>
                    </td>
                    <td>
                        <% if (report.status === 4) { %>
                            <span class="bet-status alert-end">Rejected</span>
                        <% } else if (report.status === 3) { %>
                            <span class="bet-status alert-success">Resolved</span>
                        <% } else if (report.status === 2) { %>
                            <span class="bet-status alert-accept">Under Review</span>
                        <% } else { %>
                            <span class="bet-status alert-pending">Pending</span>
                        <% } %>
                    </td>
                    <td><%= formatDate(report.createdAt) %></td>
                    <td class="text-end">
                        <div class="action-btn d-flex flex-wrap gap-2 justify-content-end">
                            <a href="/chat-report/<%= report._id %>" class="btn btn-sm btn-outline-info" title="View Detail">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <% if (report.status === 1 || report.status === 2) { %>
                                <a
                                    href="javascript:void(0);"
                                    class="btn btn-sm btn-outline-success resolve-report-btn"
                                    data-report-id="<%= report._id %>"
                                    data-report-status="<%= report.status %>"
                                    title="Resolve"
                                >
                                    <i class="fa-solid fa-check"></i>
                                </a>
                            <% } %>
                        </div>
                    </td>
                </tr>
            <% }); } else { %>
                <tr>
                    <td colspan="8" class="text-center">No chat reports found</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>
